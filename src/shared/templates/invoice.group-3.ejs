<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    font-family: Arial;
    font-size: 11px;
  }

  .layout {
    display: flex;
    min-height: 277mm;
  }

  .left {
    width: 35%;
    background: #1e3a8a;
    color: #fff;
    padding: 20px;
    box-sizing: border-box;
  }

  .right {
    width: 65%;
    padding: 20px;
    box-sizing: border-box;
  }

  .logo {
    max-height: 40px;
    margin-bottom: 10px;
  }

  .title {
    font-size: 24px;
    font-weight: bold;
  }

  .card {
    border-bottom: 1px solid #ddd;
    padding: 10px 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  td {
    padding: 6px;
    border-bottom: 1px solid #ddd;
  }

  .total {
    text-align: right;
    font-size: 16px;
    font-weight: bold;
    margin-top: 10px;
  }

</style>
</head>

<body>

<div class="layout">

  <div class="left">
    <% if (logoUrl) { %><img src="<%= logoUrl %>" class="logo"><% } %>

    <div><strong><%= brazilBiName %></strong></div>
    <div><%= brazilBiAddress %></div>
    <div>CNPJ: <%= brazilBiCnpj %></div>

    <div style="margin-top:20px;">
      <div>Invoice:</div>
      <div><%= invoiceNumber %></div>

      <div style="margin-top:10px;">Date:</div>
      <div><%= documentDate || invoiceDate %></div>
    </div>
  </div>

  <div class="right">
    <div class="title">INVOICE</div>

    <div class="card">
      <strong><%= consigneeName %></strong><br>
      <%= consigneeAddress %>
    </div>

    <div class="card">
      B/L: <%= (blNumbers || []).join(', ') %>
    </div>

    <table>
      <tr>
        <td>International Maritime Freight</td>
        <td style="text-align:right;"><%= currency %> <%= freightValue %></td>
      </tr>
    </table>

    <div class="total">
      TOTAL: <%= currency %> <%= freightValue %>
    </div>

    <div style="margin-top:16px;font-size:10px;border-top:1px solid #ddd;padding-top:10px;">
      <strong>Bank Details</strong>
      <% if (beneficiaryBank) { %><div style="margin-top:4px;"><strong>Bank:</strong> <%= beneficiaryBank %></div><% } %>
      <% if (beneficiaryAddress) { %><div><strong>Address:</strong> <%= beneficiaryAddress %></div><% } %>
      <% if (swiftCode) { %><div><strong>SWIFT:</strong> <%= swiftCode %></div><% } %>
      <% if (typeof swiftBic !== 'undefined' && swiftBic) { %><div><strong>SWIFT/BIC:</strong> <%= swiftBic %></div><% } %>
      <% if (typeof intermediaryBank !== 'undefined' && intermediaryBank) { %><div><strong>Intermediary:</strong> <%= intermediaryBank %></div><% } %>
      <div><strong>Account:</strong> <%= accountNumber %></div>
      <% if (typeof routingNumber !== 'undefined' && routingNumber) { %><div><strong>Routing:</strong> <%= routingNumber %> / MEMO FIELD: <%= beneficiaryBank %> / <%= routingNumber %></div><% } %>
    </div>

  </div>

</div>

</body>
</html>