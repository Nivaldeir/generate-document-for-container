<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  body {
    font-family: Arial, sans-serif;
    font-size: 11px;
    padding: 30px;
    color: #222;
  }

  .container {
    max-width: 170mm;
    margin: auto;
  }

  .top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 30px;
  }

  .logo {
    max-height: 40px;
    margin-bottom: 8px;
  }

  .company-name {
    font-weight: bold;
    font-size: 14px;
  }

  .invoice-box {
    text-align: right;
  }

  .invoice-title {
    font-size: 24px;
    font-weight: bold;
  }

  .section {
    margin-bottom: 20px;
  }

  .section-title {
    font-weight: bold;
    margin-bottom: 6px;
    text-transform: uppercase;
    font-size: 10px;
    color: #666;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th, td {
    padding: 8px;
    border-bottom: 1px solid #ccc;
  }

  th {
    text-align: left;
    font-size: 10px;
    color: #666;
  }

  .total {
    text-align: right;
    font-weight: bold;
    margin-top: 10px;
  }

  .bank {
    margin-top: 20px;
    font-size: 10px;
    border-top: 1px solid #ccc;
    padding-top: 10px;
  }

</style>
</head>

<body>
<div class="container">

  <div class="top">
    <div>
      <% if (logoUrl) { %>
        <img src="<%= logoUrl %>" class="logo">
      <% } %>
      <div class="company-name"><%= brazilBiName %></div>
      <div><%= brazilBiAddress %></div>
      <div>CNPJ: <%= brazilBiCnpj %></div>
    </div>

    <div class="invoice-box">
      <div class="invoice-title">INVOICE</div>
      <div># <%= invoiceNumber %></div>
      <div><%= documentDate || invoiceDate %></div>
      <div><%= currency %></div>
    </div>
  </div>

  <div class="section">
    <div class="section-title">Bill To</div>
    <strong><%= consigneeName %></strong><br>
    <%= consigneeAddress %>
  </div>

  <div class="section">
    <div class="section-title">Service</div>
    <%= serviceDescription %>
  </div>

  <table>
    <tr>
      <th>Description</th>
      <th>Qty</th>
      <th>Unit</th>
      <th>Total</th>
    </tr>
    <tr>
      <td><%= description %></td>
      <td>1</td>
      <td><%= freightValue %></td>
      <td><%= freightValue %></td>
    </tr>
  </table>

  <div class="total">
    TOTAL: <%= currency %> <%= freightValue %>
  </div>

  <div class="bank">
    <strong>Bank Details</strong><br>
    <%= beneficiaryBank %><br>
    <%= beneficiaryAddress %><br>
    SWIFT: <%= swiftCode || swiftBic %><br>
    Account: <%= accountNumber %>
  </div>

</div>
</body>
</html>