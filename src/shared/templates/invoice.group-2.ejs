<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  body {
    font-family: Arial;
    background: #f8fafc;
    font-size: 11px;
    margin: 20px;
  }

  .container {
    max-width: 170mm;
    margin: auto;
  }

  .top {
    display: flex;
    justify-content: space-between;
    margin-bottom: 12px;
  }

  .title {
    font-size: 22px;
    font-weight: bold;
  }

  .card {
    background: #fff;
    border-radius: 12px;
    padding: 14px;
    margin-top: 10px;
    box-shadow: 0 2px 6px rgba(0,0,0,0.05);
  }

  .label {
    font-size: 10px;
    color: #64748b;
    margin-bottom: 4px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th {
    text-align: left;
    font-size: 10px;
    color: #64748b;
    padding-bottom: 6px;
  }

  td {
    padding: 6px 0;
  }

  .total {
    text-align: right;
    font-size: 16px;
    font-weight: bold;
    margin-top: 10px;
  }

</style>
</head>

<body>
<div class="container">

  <div class="top">
    <div>
      <% if (logoUrl) { %><img src="<%= logoUrl %>" style="max-height:40px;"><% } %>
      <div><strong><%= brazilBiName %></strong></div>
    </div>

    <div style="text-align:right;">
      <div class="title">INVOICE</div>
      <div style="margin-top:4px;"># <%= invoiceNumber %></div>
      <div style="color:#64748b;"><%= documentDate || invoiceDate %></div>
    </div>
  </div>

  <div class="card">
    <div class="label">Bill To</div>
    <strong><%= consigneeName %></strong><br>
    <%= consigneeAddress %>
    <% if (blNumbers && blNumbers.length) { %>
      <div style="margin-top:6px;color:#64748b;font-size:10px;">B/L: <%= blNumbers.join(', ') %></div>
    <% } %>
  </div>

  <div class="card">
    <table>
      <tr>
        <th>Description</th>
        <th>Amount</th>
      </tr>
      <tr>
        <td>International Maritime Freight</td>
        <td><%= currency %> <%= freightValue %></td>
      </tr>
    </table>

    <div class="total"><%= currency %> <%= freightValue %></div>
  </div>

</div>
</body>
</html>