<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  html, body {
    margin: 0;
    padding: 0;
    height: 100%;
    font-family: Arial;
    font-size: 11px;
  }

  .layout {
    display: flex;
    min-height: 277mm;
  }

  .left {
    width: 35%;
    background: #1e3a8a;
    color: #fff;
    padding: 20px;
    box-sizing: border-box;
  }

  .right {
    width: 65%;
    padding: 20px;
    box-sizing: border-box;
  }

  .logo {
    max-height: 40px;
    margin-bottom: 10px;
  }

  .title {
    font-size: 24px;
    font-weight: bold;
  }

  .card {
    border-bottom: 1px solid #ddd;
    padding: 10px 0;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  td {
    padding: 6px;
    border-bottom: 1px solid #ddd;
  }

  .total {
    text-align: right;
    font-size: 16px;
    font-weight: bold;
    margin-top: 10px;
  }

  .bank-section {
    margin-top: 16px;
    font-size: 10px;
    border-top: 1px solid #ddd;
    padding-top: 10px;
  }

  .bank-row {
    margin-bottom: 3px;
  }
</style>
</head>

<body>
<div class="layout">

  <div class="left">
    <% if (logoUrl) { %><img src="<%= logoUrl %>" class="logo"><% } %>

    <div><strong><%= consigneeName %></strong></div>
    <div style="margin-top:4px;font-size:10px;opacity:0.85;"><%= consigneeAddress %></div>

    <div style="margin-top:20px;">
      <div style="opacity:0.7;font-size:10px;">Invoice:</div>
      <div><%= invoiceNumber %></div>

      <div style="margin-top:10px;opacity:0.7;font-size:10px;">Date:</div>
      <div><%= documentDate || invoiceDate %></div>

      <div style="margin-top:10px;opacity:0.7;font-size:10px;">Currency:</div>
      <div><%= currency %></div>
    </div>
  </div>

  <div class="right">
    <div class="title">INVOICE</div>

    <div class="card">
      <strong><%= brazilBiName %></strong><br>
      <div style="font-size:10px;opacity:0.85;"><%= brazilBiAddress %></div>
      <div style="font-size:10px;opacity:0.85;">CNPJ: <%= brazilBiCnpj %></div>
    </div>

    <% if (typeof serviceDescription !== 'undefined' && serviceDescription) { %>
    <div class="card">
      <div style="font-size:10px;color:#64748b;margin-bottom:4px;">SERVICE</div>
      <%= serviceDescription %>
    </div>
    <% } %>

    <table style="margin-top:12px;">
      <tr>
        <td><%= description %></td>
        <td style="text-align:right;"><%= currency %> <%= freightValue %></td>
      </tr>
    </table>

    <div class="total">
      TOTAL: <%= currency %> <%= freightValue %>
    </div>

    <div class="bank-section">
      <strong>Bank Details</strong>
      <% if (beneficiaryBank) { %><div class="bank-row"><strong>Bank:</strong> <%= beneficiaryBank %></div><% } %>
      <% if (beneficiaryAddress) { %><div class="bank-row"><strong>Address:</strong> <%= beneficiaryAddress %></div><% } %>
      <% if (swiftCode) { %><div class="bank-row"><strong>SWIFT:</strong> <%= swiftCode %></div><% } %>
      <% if (typeof swiftBic !== 'undefined' && swiftBic) { %><div class="bank-row"><strong>SWIFT/BIC:</strong> <%= swiftBic %></div><% } %>
      <% if (typeof intermediaryBank !== 'undefined' && intermediaryBank) { %><div class="bank-row"><strong>Intermediary:</strong> <%= intermediaryBank %></div><% } %>
      <div class="bank-row"><strong>Account:</strong> <%= accountNumber %></div>
      <% if (typeof routingNumber !== 'undefined' && routingNumber) { %><div class="bank-row"><strong>Routing:</strong> <%= routingNumber %></div><% } %>
    </div>
  </div>

</div>
</body>
</html>
