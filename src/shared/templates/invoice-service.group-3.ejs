<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  body {
    font-family: Arial;
    font-size: 11px;
    padding: 20px;
  }

  .container {
    max-width: 170mm;
    margin: auto;
  }

  .header {
    border: 2px solid #000;
    padding: 10px;
    margin-bottom: 10px;
  }

  .title {
    font-size: 18px;
    font-weight: bold;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 10px;
  }

  .box {
    border: 1px solid #000;
    padding: 6px;
  }

  .label {
    font-weight: bold;
    font-size: 9px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 10px;
  }

  td, th {
    border: 1px solid #000;
    padding: 6px;
  }

  .total {
    font-weight: bold;
  }

</style>
</head>

<body>
<div class="container">

  <div class="header">
    <% if (logoUrl) { %>
      <img src="<%= logoUrl %>" style="max-height:30px;"><br>
    <% } %>
    <div class="title">INVOICE</div>
    <div><%= brazilBiName %></div>
  </div>

  <div class="grid">
    <div class="box">
      <div class="label">CLIENT</div>
      <%= consigneeName %><br>
      <%= consigneeAddress %>
    </div>

    <div class="box">
      <div class="label">INFO</div>
      Nº: <%= invoiceNumber %><br>
      Date: <%= documentDate || invoiceDate %><br>
      Currency: <%= currency %>
    </div>
  </div>

  <div class="box">
    <div class="label">SERVICE DESCRIPTION</div>
    <%= serviceDescription %>
  </div>

  <table>
    <tr>
      <th>Description</th>
      <th>Qty</th>
      <th>Value</th>
    </tr>
    <tr>
      <td><%= description %></td>
      <td>1</td>
      <td><%= freightValue %></td>
    </tr>
    <tr class="total">
      <td colspan="2">TOTAL</td>
      <td><%= currency %> <%= freightValue %></td>
    </tr>
  </table>

  <div class="box" style="margin-top:10px;">
    <div class="label">BANK DETAILS</div>
    Bank: <%= beneficiaryBank %><br>
    Address: <%= beneficiaryAddress %><br>
    SWIFT: <%= swiftCode || swiftBic %><br>
    Account: <%= accountNumber %>
  </div>

</div>
</body>
</html>