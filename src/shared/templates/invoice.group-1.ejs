<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  body {
    font-family: Arial;
    font-size: 11px;
    margin: 20px;
    background: #0f172a;
    color: #e2e8f0;
  }

  .container {
    max-width: 170mm;
    margin: auto;
  }

  .top {
    background: linear-gradient(135deg, #0f172a, #1e293b);
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 16px;
    display: flex;
    justify-content: space-between;
  }

  .logo { max-height: 40px; }

  .title {
    font-size: 22px;
    font-weight: bold;
  }

  .card {
    background: #1e293b;
    border: 1px solid #334155;
    border-radius: 12px;
    padding: 12px;
    margin-top: 12px;
  }

  .label {
    font-weight: bold;
    color: #60a5fa;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  th, td {
    border: 1px solid #334155;
    padding: 8px;
  }

  th {
    background: #0f172a;
  }

  .total {
    text-align: right;
    font-size: 16px;
    margin-top: 10px;
    font-weight: bold;
    color: #60a5fa;
  }

</style>
</head>

<body>
<div class="container">

  <div class="top">
    <div>
      <% if (logoUrl) { %><img src="<%= logoUrl %>" class="logo"><% } %>
      <div><strong><%= brazilBiName %></strong></div>
      <div><%= brazilBiAddress %></div>
      <div>CNPJ: <%= brazilBiCnpj %></div>
    </div>

    <div style="text-align:right;">
      <div class="title">INVOICE</div>
      <div>No: <%= invoiceNumber %></div>
      <div><%= documentDate || invoiceDate %></div>
    </div>
  </div>

  <div class="card">
    <div class="label">CLIENT</div>
    <strong><%= consigneeName %></strong><br>
    <%= consigneeAddress %><br><br>
    B/L: <%= (blNumbers || []).join(', ') %>
  </div>

  <div class="card">
    <table>
      <tr>
        <th>Description</th>
        <th>Currency</th>
        <th style="text-align:right;">Amount</th>
      </tr>
      <tr>
        <td>International Maritime Freight</td>
        <td><%= currency %></td>
        <td style="text-align:right;"><%= currency %> <%= freightValue %></td>
      </tr>
    </table>

    <div class="total">TOTAL: <%= currency %> <%= freightValue %></div>
  </div>

</div>
</body>
</html>