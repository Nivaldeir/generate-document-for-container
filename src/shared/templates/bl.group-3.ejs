<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  body {
    font-family: Arial, sans-serif;
    font-size: 10px;
    margin: 0;
    background: #f5f5f5;
  }

  .page {
    max-width: 180mm;
    margin: auto;
    background: #fff;
    padding: 15px;
  }

  .header {
    background: #111;
    color: #fff;
    padding: 8px;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .header h1 {
    font-size: 14px;
    margin: 0;
  }

  .logo {
    max-height: 30px;
  }

  .box {
    border: 1px solid #ddd;
    padding: 6px;
    margin-top: 6px;
  }

  .title {
    font-weight: bold;
    font-size: 8px;
    color: #555;
    margin-bottom: 3px;
  }

  .grid {
    display: grid;
    gap: 6px;
  }

  .grid-2 { grid-template-columns: 1fr 1fr; }
  .grid-3 { grid-template-columns: 1fr 1fr 1fr; }

  .strong {
    font-weight: bold;
    font-size: 11px;
  }

  table {
    width: 100%;
    border-collapse: collapse;
    margin-top: 8px;
  }

  td {
    border: 1px solid #ddd;
    padding: 4px;
  }

</style>
</head>

<body>
<div class="page">

  <div class="header">
    <h1>BILL OF LADING</h1>
    <% if (logoUrl) { %>
      <img src="<%= logoUrl %>" class="logo">
    <% } %>
  </div>

  <div class="grid grid-2">
    <div class="box">
      <div class="title">SHIPPER</div>
      <%= shipperName %><br>
      <%= shipperAddress %><br>
      <%= shipperCnpj %>
    </div>

    <div class="box">
      <div class="title">CONSIGNEE</div>
      <%= consigneeName %><br>
      <%= consigneeAddress %>
    </div>
  </div>

  <div class="grid grid-3">
    <div class="box">
      <div class="title">BOOKING</div>
      <div class="strong"><%= bookingNo %></div>
    </div>

    <div class="box">
      <div class="title">BL</div>
      <div class="strong"><%= blNumber %></div>
    </div>

    <div class="box">
      <div class="title">VESSEL</div>
      <%= vessel %>
    </div>
  </div>

  <div class="grid grid-3">
    <div class="box">
      <div class="title">LOADING</div>
      <%= portOfLoading %>
    </div>

    <div class="box">
      <div class="title">DISCHARGE</div>
      <%= portOfDischarge %>
    </div>

    <div class="box">
      <div class="title">DELIVERY</div>
      <%= placeOfDelivery %>
    </div>
  </div>

  <div class="box">
    <div class="title">CARGO</div>
    <%= containers %> - <%= containerType %><br><br>

    <%= packages %> OF <%= description %><br>
    NCM: <%= ncm %><br>
    NET: <%= netWeight %> KGS
  </div>

  <div class="grid grid-2">
    <div class="box">
      <div class="title">WEIGHT</div>
      <%= grossWeight %> KGS
    </div>

    <div class="box">
      <div class="title">VOLUME</div>
      <%= measurement %> CBM
    </div>
  </div>

  <table>
    <tr>
      <td>DESCRIPTION</td>
      <td>VALUE</td>
    </tr>
    <tr>
      <td>FREIGHT</td>
      <td><%= currency %> <%= freightValue %></td>
    </tr>
  </table>

  <div class="grid grid-2">
    <div class="box">
      <div class="title">DATES</div>
      Issue: <%= documentDate || issueDate %><br>
      On Board: <%= shippedOnBoardDate %>
    </div>

    <div class="box">
      <div class="title">SIGNATURE</div>
      <% if (signatureUrl) { %>
        <img src="<%= signatureUrl %>" style="max-height:40px;">
      <% } %>
    </div>
  </div>

</div>
</body>
</html>