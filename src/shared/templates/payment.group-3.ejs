<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<style>
  body {
    font-family: Arial;
    font-size: 10px;
    margin: 20px;
  }

  .container {
    max-width: 170mm;
    margin: auto;
  }

  .header {
    text-align: center;
    border-bottom: 2px solid #000;
    margin-bottom: 15px;
    padding-bottom: 5px;
  }

  .section {
    border: 1px solid #000;
    padding: 8px;
    margin-bottom: 8px;
  }

  .grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 8px;
  }

  .label {
    font-weight: bold;
  }

  table {
    width: 100%;
    border-collapse: collapse;
  }

  td, th {
    border: 1px solid #000;
    padding: 6px;
  }

  .total {
    text-align: right;
    font-weight: bold;
    margin-top: 8px;
  }

</style>
</head>

<body>
<div class="container">

  <div class="header">
    <div style="display:flex; justify-content:space-between; align-items:flex-end; margin-bottom:6px;">
      <div style="text-align:left;">
        <strong><%= brazilBiName %></strong><br>
        <%= brazilBiAddress %><br>
        CNPJ: <%= brazilBiCnpj %>
      </div>
      <div style="text-align:right;">
        <strong>PAGAMENTO DE FRETE</strong><br>
        Circular: <%= circular %> | <%= documentDate || paymentDate %>
      </div>
    </div>
  </div>

  <div class="grid">
    <div class="section">
      <span class="label">Remetente</span><br>
      <%= brazilBiName %><br>
      CNPJ: <%= brazilBiCnpj %>
    </div>

    <div class="section">
      <span class="label">Recebedor</span><br>
      <% if (logoUrl) { %><img src="<%= logoUrl %>" alt="Logo" style="max-height:30px; max-width:100px; object-fit:contain; display:block; margin:4px 0;"><% } %>
      <%= consigneeName %><br>
      <%= consigneeAddress %>
    </div>
  </div>

  <div class="section">
    <table>
      <% (blNumbers || []).forEach(function(bl) { %>
      <tr>
        <td><%= bl %> - <%= vessel %></td>
        <td><%= incoterm %></td>
        <td style="text-align:right;"><%= currency %> <%= freightValue %></td>
      </tr>
      <% }); %>
    </table>

    <div class="total">
      TOTAL: <%= currency %> <%= freightValue %>
    </div>
  </div>

</div>
</body>
</html>