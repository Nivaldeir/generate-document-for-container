# PostgreSQL (ex.: local, Docker, Neon, Supabase). No primeiro uso: pnpm prisma db push
DATABASE_URL="postgresql://usuario:senha@localhost:5432/nome_do_banco?schema=public"

# NextAuth (obrigatório para login)
# Gerar com: openssl rand -base64 32
AUTH_SECRET=

# Puppeteer: evita download do Chromium no "npm install" (use se já tiver Chrome instalado)
# Definir como true antes de rodar npm install, ou use: npm run install:skip-puppeteer
# PUPPETEER_SKIP_DOWNLOAD=true
# Caminho do Chrome (obrigatório se PUPPETEER_SKIP_DOWNLOAD=true): PUPPETEER_EXECUTABLE_PATH=
